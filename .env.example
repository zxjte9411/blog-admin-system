POSTGRES_DB=blog_admin
POSTGRES_USER=blog_admin
POSTGRES_PASSWORD=
# Generate a random value of at least 32 bytes; do not use a predictable secret.
APP_SECURITY_JWT_SECRET=
# Supabase issuer URL, e.g. https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# Supabase JWKS URL, e.g. https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Browser-visible Supabase project URL; never use a service role key here.
SUPABASE_URL=
# Browser-visible Supabase publishable key; never use a secret key here.
SUPABASE_PUBLISHABLE_KEY=
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# Required: fill this with a local-only, non-common password (at least 8 characters).
APP_BOOTSTRAP_ADMIN_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
