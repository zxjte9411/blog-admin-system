{
  "name": "blog-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "sh scripts/generate-config.sh && ng serve",
    "build": "ng build",
    "typecheck": "ng build --configuration development",
    "lint": "eslint .",
    "lint:format": "prettier --check \"src/**/*.{ts,html,scss}\" \"scripts/**/*.mjs\" \"*.json\"",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/test.mjs",
    "test:e2e": "node ../scripts/e2e-audit.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@supabase/supabase-js": "^2.112.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.8"
  }
}
